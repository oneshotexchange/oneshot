# Node 22+. Keep actual credentials in an ignored env file or provider secrets.
# Node/npm do not load this file automatically. See docs/deployment-verification.md.
APTOS_NETWORK=testnet
APTOS_CHAIN_ID=2
APTOS_FULLNODE_URL=https://api.testnet.aptoslabs.com/v1
APTOS_INDEXER_URL=https://api.testnet.aptoslabs.com/v1/graphql
APTOS_GRPC_ENDPOINT=grpc.testnet.aptoslabs.com:443
GEOMI_API_KEY=
DATABASE_URL=

# Disabled until the deployment manifest, database and real stream are reviewed.
B20_WORKER_ENABLED=false
B20_PACKAGE_ADDRESS=
B20_DEPLOYMENT_VERSION=
B20_DEPLOYMENT_VERIFIED=false
B20_EXPECTED_ABI_SHA256=

# New-pool snapshots only. A configured tier still needs on-chain DEX verification.
B20_DEX_FEE_BPS=25
B20_SUPPORTED_DEX_FEE_BPS=25
B20_STREAM_BATCH_SIZE=100
B20_STREAM_MAX_MESSAGE_BYTES=16777216
B20_STREAM_MAX_EVENTS_PER_TX=10000
B20_MAX_EVENT_DATA_BYTES=65536
B20_STATUS_PORT=42070

# No verified current Hyperion testnet integration; retain these disabled flags.
HYPERION_ENABLED=false
HYPERION_PACKAGE_ADDRESS=
HYPERION_DEPLOYMENT_VERIFIED=false
HYPERION_EXPECTED_ABI_SHA256=

# NFT flows need no keeper. No execution adapter is registered for this release.
B20_KEEPER_ENABLED=false
B20_KEEPER_ACCOUNT_ADDRESS=
B20_KEEPER_PRIVATE_KEY=
# Future reviewed moduleName::functionName only; never an arbitrary entry function.
B20_KEEPER_MODULE=
B20_KEEPER_INTERVAL_MS=60000
B20_KEEPER_MAX_JOBS=5

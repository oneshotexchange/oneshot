# Copy to secrets/api.env. Environment files and secrets are excluded from Git
# and the Docker build context. Do not add DATABASE_URL: it is built at runtime.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
S3_BUCKET=oneshot-media
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ONESHOT_MEDIA_QUOTA_BYTES=1073741824
# Optional redacted request completion JSON in API logs. Disabled by default.
ONESHOT_REQUEST_METRICS=false
# Network facts remain unconfigured until verified. No worker is deployed.
ONESHOT_NETWORK=zero
ONESHOT_CHAIN_ID=
ONESHOT_RPC_URL=
ONESHOT_RPC_PROVIDER=custom
ONESHOT_GENESIS_HASH=
ONESHOT_NATIVE_DECIMALS=
ONESHOT_EXPLORER_URL=
ONESHOT_CONFIG_SOURCE_URL=

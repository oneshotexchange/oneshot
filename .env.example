# API settings: copy to apps/api/.env.local. Never put server secrets in the web.
# Frontend settings live separately in apps/web/.env.example.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
ONESHOT_API_URL=http://127.0.0.1:3001

# Server-only administrator password (minimum 16 characters). Never use NEXT_PUBLIC_.
# /admin stays locked when this is missing. Sessions expire after 30 minutes.
ONESHOT_ADMIN_PASSWORD=

# Create/configure an oneshot Privy app and allow the exact local/hosted origins.
# App IDs are public; the server App Secret must never have NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Genesis uses official X OAuth independently of Privy. Register this exact callback
# on the X app; hosted callbacks use the web origin via the Genesis Pages proxy.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/oneshot/genesis/auth/callback
# Server-only public X evidence reads using the saved numeric X identity.
# Open/configure Genesis from authenticated /admin/genesis after migration.
GETX_API_KEY=

# Development may use local files. Hosted account drafts require PostgreSQL;
# hosted images/metadata also require durable S3-compatible object storage.
# Run npm run db:migrate -- --env-file apps/api/.env.local from the repo root.
# No chain worker is enabled.
DATABASE_URL=
ONESHOT_DATA_DIR=.local/oneshot
ONESHOT_MEDIA_QUOTA_BYTES=1073741824
# Optional server-only JSON request timings; contains fixed route templates only.
# No request URLs, query values, identifiers, headers or exception details are logged.
ONESHOT_REQUEST_METRICS=false
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Missing Zero facts stay blank. No builder invitation is assumed mandatory.
ONESHOT_NETWORK=zero
ONESHOT_CHAIN_ID=
ONESHOT_RPC_URL=
# A label only: custom, official or alchemy. It does not prove Zero support.
ONESHOT_RPC_PROVIDER=custom
ONESHOT_GENESIS_HASH=
ONESHOT_NATIVE_DECIMALS=
ONESHOT_EXPLORER_URL=
ONESHOT_CONFIG_SOURCE_URL=

# Optional public read-only NFT browsing against an explicitly local deployment.
# Keep disabled for Zero until its deployment/profile has been independently verified.
ONESHOT_INDEXER_READS_ENABLED=false
ONESHOT_INDEXER_MANIFEST_PATH=

# Explicit local-only NFT transaction review/simulation; never enables Zero.
# Requires ONESHOT_NETWORK=local and a running, verified manifest above.
ONESHOT_LOCAL_NFT_EXECUTION_ENABLED=false

# Private guarded marketplace v2 configuration (local chain31337 only).
# Comma-separated creator addresses; never add NEXT_PUBLIC_ to either variable.
# Match the authority in the verified v2 manifest; keep the key in server secrets.
ONESHOT_FLOOR_CREATORS=
ONESHOT_LISTING_AUTHORITY_PRIVATE_KEY=

# Configuration completeness does not enable transactions or imply a verified deployment.
# For explicit local arithmetic experiments, ONESHOT_NETWORK=local selects
# localhost Anvil chain31337 / ETH18. It is never labelled Zero.
# Local smoke testing starts its own ephemeral chain and needs no environment file.
# Older Aptos-only variables are documented in docs/legacy/aptos.env.example.

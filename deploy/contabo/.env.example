# Public hostname only, without https:// or a path. DNS must point to the VPS.
API_DOMAIN=api.example.com
WEB_ORIGIN=https://app.example.com
ACME_EMAIL=ops@example.com
# Use a Git commit ID for deployments and keep the previous image for rollback.
IMAGE_TAG=local
# Initial bootstrap creates oneshot. Change only to a verified restored database
# in this same cluster; API, migrations and backups all follow this selection.
POSTGRES_APP_DB=oneshot
# Separate PRIVATE R2 Standard-class bucket, never the public media bucket.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/oneshot-backups/postgres

# Copy to secrets/backup.env. Use a separate R2 token restricted to backups bucket.
# Restic needs object read/write/delete/list to prune its encrypted repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep room for the running database and host. Dump limits do not reserve disk
# against other writers; monitor the host and test restores before launch.
BACKUP_MIN_FREE_MIB=20480
BACKUP_MAX_DUMP_MIB=0
BACKUP_DISK_POLL_SECONDS=1
